{
  "$defs": {
    "nullableStats": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "mean": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "max",
        "mean"
      ],
      "type": "object"
    },
    "nullableTimingAggregate": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "type": "integer"
        },
        "sum_ms": {
          "minimum": 0,
          "type": "number"
        },
        "max_ms": {
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "count",
        "sum_ms",
        "max_ms"
      ],
      "type": "object"
    },
    "tierCount": {
      "additionalProperties": false,
      "properties": {
        "detector": {
          "enum": [
            "semantic",
            "session",
            "combined"
          ]
        },
        "tier": {
          "minimum": 1,
          "maximum": 3,
          "type": "integer"
        },
        "count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "detector",
        "tier",
        "count"
      ],
      "type": "object"
    }
  },
  "$id": "pi.eval-row/v4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "context": {
            "properties": {
              "schema": {
                "const": "pi.context-telemetry/v4"
              }
            }
          }
        },
        "required": [
          "context"
        ]
      },
      "then": {
        "properties": {
          "context": {
            "required": [
              "surface"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "arm": {
            "not": {
              "const": "one-shot"
            }
          }
        },
        "required": [
          "arm"
        ]
      },
      "then": {
        "required": [
          "trajectory",
          "gate_session_id",
          "child_telemetry"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "experiment": {
            "type": "object"
          }
        },
        "required": [
          "experiment"
        ]
      },
      "then": {
        "properties": {
          "trajectory": {
            "required": [
              "search_spans",
              "read_span"
            ]
          }
        },
        "required": [
          "span_receipt_success",
          "config",
          "experiment",
          "harness",
          "trajectory",
          "context"
        ]
      }
    }
  ],
  "properties": {
    "arm": {
      "type": "string"
    },
    "authoritative": {
      "type": "boolean"
    },
    "config": {
      "properties": {
        "declared_env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "rendered_governor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "declared_env",
        "rendered_governor_sha256"
      ],
      "type": "object"
    },
    "context": {
      "additionalProperties": false,
      "properties": {
        "authenticated": {
          "const": true
        },
        "bash_output_guard": {
          "additionalProperties": false,
          "properties": {
            "cwd_escape_suspected": {
              "minimum": 0,
              "type": "integer"
            },
            "withheld": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "withheld",
            "cwd_escape_suspected"
          ],
          "type": "object"
        },
        "compactions": {
          "additionalProperties": false,
          "properties": {
            "compact_tool": {
              "minimum": 0,
              "type": "integer"
            },
            "extension_content": {
              "minimum": 0,
              "type": "integer"
            },
            "manual": {
              "minimum": 0,
              "type": "integer"
            },
            "manual_unknown": {
              "minimum": 0,
              "type": "integer"
            },
            "overflow": {
              "minimum": 0,
              "type": "integer"
            },
            "pi": {
              "minimum": 0,
              "type": "integer"
            },
            "threshold": {
              "minimum": 0,
              "type": "integer"
            },
            "total": {
              "minimum": 0,
              "type": "integer"
            },
            "watcher": {
              "minimum": 0,
              "type": "integer"
            },
            "will_retry": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "total",
            "watcher",
            "pi",
            "compact_tool",
            "manual_unknown",
            "extension_content",
            "threshold",
            "overflow",
            "manual",
            "will_retry"
