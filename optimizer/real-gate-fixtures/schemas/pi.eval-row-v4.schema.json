          "type": "object"
        },
        "config": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rearmPct": {
              "maximum": 99,
              "minimum": 1,
              "type": "integer"
            },
            "thresholdPct": {
              "maximum": 99,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "enabled",
            "thresholdPct",
            "rearmPct"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "events": {
          "minimum": 0,
          "type": "integer"
        },
        "failure_episodes": {
          "additionalProperties": false,
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "settlement_summaries": {
              "minimum": 0,
