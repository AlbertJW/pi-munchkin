        "authenticated",
        "content_sha256",
        "session_key",
        "events",
        "harness_surface_sha256",
        "config",
        "compactions",
        "watcher",
        "surface",
        "bash_output_guard",
        "plan_runner_delegation",
        "provenance",
        "failure_episodes",
        "provider_timing",
        "verification_frontier"
      ],
      "type": "object"
    },
    "experiment": {
      "properties": {
        "cell": {
          "minLength": 1,
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "manifest_sha256",
        "cell"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "exposure": {
      "additionalProperties": false,
      "properties": {
        "counts": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "type": "object"
        },
        "mode": {
          "enum": [
            "configuration",
            "telemetry"
          ]
        },
        "status": {
          "enum": [
            "control",
            "targeted",
            "engaged_only",
            "unexposed"
          ]
        },
        "target_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "status",
        "target_count",
        "counts"
      ],
      "type": "object"
    },
    "fixture": {
      "required": [
        "cohort",
        "version"
      ],
      "type": "object"
    },
    "harness": {
      "properties": {
        "hash_blocker": {
          "type": "string"
        },
        "surface_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "surface_sha256",
        "hash_blocker"
      ],
      "type": "object"
    },
    "model": {
      "type": "string"
    },
    "prompt": {
      "required": [
        "variant",
        "semantic_group",
        "sha256"
      ],
      "type": "object"
    },
    "repetition": {
      "minimum": 1,
      "type": "integer"
    },
    "run": {
      "type": "string"
    },
    "schema": {
      "const": "pi.eval-row/v4"
    },
    "score": {
      "maximum": 1,
      "minimum": 0,
      "type": "integer"
    },
    "serving": {
      "required": [
        "pre",
        "post",
        "stable"
      ],
      "type": "object"
    },
    "span_receipt_success": {
      "type": "boolean"
    },
    "split": {
      "enum": [
        "val",
        "heldout",
        "robustness"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "incomplete",
        "exploratory",
        "ineligible"
      ]
    },
    "subscores": {
      "description": "Graded partial credit from a fixture whose hidden grader emits one. OPTIONAL and additive: `score` stays the strict binary gate bit, so rows without subscores remain valid and cross-round pass-rate comparisons are unaffected. Written by real_gate.sh when the workdir contains a grader artifact (e.g. audit-sweep's .audit-grade.json).",
      "properties": {
        "detail": {
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "per-check name -> bool, as the grader emitted it",
          "type": "object"
        },
        "fixed": {
          "description": "sub-checks the session actually passed",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "description": "grader artifact the values came from, relative to the workdir",
          "type": "string"
        },
        "total": {
          "description": "sub-checks the grader ran",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "fixed",
        "total"
      ],
      "type": "object"
    },
    "subscores_blocked": {
      "type": "string",
      "description": "Why graded subscores were REFUSED for this row: 'missing' (the manifest's pinned grade_artifact was not produced), 'ambiguous:<n>' (other .*-grade.json files were present alongside it -- the workdir is model-writable, so the gate refuses rather than picks), 'unpinned:<n>' (an artifact appeared that the fixture never declared), 'malformed', or 'error:<Type>'. Absent on the normal path. `score` is unaffected either way; see prompt-lab/grade_artifact.py."
    },
    "task": {
      "type": "string"
    },
    "gate_session_id": {
      "pattern": "^[0-9a-f]{32}$",
      "type": "string"
    },
    "child_telemetry": {
      "enum": ["not-used", "unavailable-contained"]
    },
    "trajectory": {
      "properties": {
        "compactions": {
          "minimum": 0,
          "type": "integer"
        },
        "first_mutation_turn": {
          "minimum": 0,
          "type": "integer"
        },
        "read_span": {
          "minimum": 0,
          "type": "integer"
        },
        "reads": {
          "minimum": 0,
          "type": "integer"
        },
        "repeat_calls": {
          "minimum": 0,
          "type": "integer"
        },
        "repeat_reads": {
          "minimum": 0,
          "type": "integer"
        },
        "search_spans": {
          "minimum": 0,
          "type": "integer"
        },
        "subagent_calls": {
          "minimum": 0,
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
