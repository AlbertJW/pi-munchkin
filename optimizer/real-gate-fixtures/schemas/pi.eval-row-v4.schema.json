            },
            "observed_events": {
              "minimum": 0,
              "type": "integer"
            },
            "recovered_events": {
              "minimum": 0,
              "type": "integer"
            },
            "abandoned_events": {
              "minimum": 0,
              "type": "integer"
            },
            "total_episodes": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "total_failures": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "longest_episode": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "semantic_failure_overrun": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "correlated_failure_overrun": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "settled_without_recovery": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "failures_after_second": {
              "minimum": 0,
              "type": "integer"
            },
            "recovered_episodes": {
              "minimum": 0,
              "type": "integer"
            },
            "recovery_calls_total": {
              "minimum": 0,
              "type": "integer"
            },
            "recovery_calls_max": {
              "minimum": 0,
              "type": "integer"
            },
            "tier_observed": {
              "items": {
                "$ref": "#/$defs/tierCount"
              },
              "maxItems": 9,
              "type": "array"
            },
            "interventions": {
              "items": {
                "$ref": "#/$defs/tierCount"
              },
              "maxItems": 9,
              "type": "array"
            }
          },
          "required": [
            "complete",
            "settlement_summaries",
            "opened_events",
            "observed_events",
            "recovered_events",
            "abandoned_events",
            "total_episodes",
            "total_failures",
            "longest_episode",
            "semantic_failure_overrun",
            "correlated_failure_overrun",
            "settled_without_recovery",
            "failures_after_second",
            "recovered_episodes",
            "recovery_calls_total",
            "recovery_calls_max",
            "tier_observed",
            "interventions"
          ],
          "type": "object"
        },
        "harness_surface_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "plan_runner_delegation": {
          "additionalProperties": false,
          "properties": {
            "blocked": {
              "minimum": 0,
              "type": "integer"
