                "integer",
                "null"
              ]
            },
            "current_passed": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "current_failed": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "current_skipped": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "current_total": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "best_passed": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "best_failed": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "best_skipped": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "best_total": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "last_advanced": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "plateau_streak": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "successful_mutation_epochs_since_advance": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "verification_plateau_overrun": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
