            "complete",
            "settlement_summaries",
            "protocol",
            "recognized_gates",
            "current_passed",
            "current_failed",
            "current_skipped",
            "current_total",
            "best_passed",
            "best_failed",
            "best_skipped",
            "best_total",
            "last_advanced",
            "plateau_streak",
            "successful_mutation_epochs_since_advance",
            "verification_plateau_overrun"
          ],
          "type": "object"
        },
        "schema": {
          "const": "pi.context-telemetry/v4"
        },
        "session_key": {
          "minLength": 1,
          "type": "string"
        },
        "surface": {
          "additionalProperties": false,
          "properties": {
            "calls": {
              "minimum": 0,
              "type": "integer"
            },
            "concentration": {
              "additionalProperties": false,
              "properties": {
                "largest_message": {
                  "$ref": "#/$defs/nullableStats"
                },
                "largest_tool_result": {
                  "$ref": "#/$defs/nullableStats"
                }
              },
              "required": [
                "largest_message",
                "largest_tool_result"
              ],
              "type": "object"
            },
            "context": {
              "additionalProperties": false,
              "properties": {
                "max_bytes": {
                  "minimum": 0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "mean_bytes": {
                  "minimum": 0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "tokens": {
                  "$ref": "#/$defs/nullableStats"
                }
              },
              "required": [
                "max_bytes",
                "mean_bytes",
                "tokens"
              ],
              "type": "object"
            },
            "duplication": {
              "additionalProperties": false,
              "properties": {
                "exact_block": {
                  "$ref": "#/$defs/nullableStats"
                },
                "five_token_shingle": {
                  "$ref": "#/$defs/nullableStats"
                },
                "near_block": {
                  "$ref": "#/$defs/nullableStats"
                }
              },
              "required": [
                "exact_block",
                "five_token_shingle",
                "near_block"
              ],
              "type": "object"
            },
            "kv_cache": {
              "additionalProperties": false,
              "properties": {
                "appended_only_rate": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "prefix_stable_rate": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "system_prompt_changes": {
                  "minimum": 0,
                  "type": "integer"
