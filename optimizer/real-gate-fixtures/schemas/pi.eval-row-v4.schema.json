          "type": "object"
        },
        "provenance": {
          "additionalProperties": false,
          "properties": {
            "schema": { "const": "pi.gate-session/v1" },
            "complete": { "type": "boolean" },
            "mismatches": { "items": { "type": "string" }, "type": "array" },
            "run_id": { "type": ["string", "null"] },
            "provider": { "type": ["string", "null"] },
            "model": { "type": ["string", "null"] },
            "requested_provider": { "type": ["string", "null"] },
            "requested_model": { "type": ["string", "null"] },
            "config_sha256": { "pattern": "^[0-9a-f]{64}$", "type": ["string", "null"] },
            "harness_surface_sha256": { "pattern": "^[0-9a-f]{64}$", "type": ["string", "null"] }
          },
          "required": ["schema", "complete", "mismatches", "run_id", "provider", "model", "requested_provider", "requested_model", "config_sha256", "harness_surface_sha256"],
          "type": "object"
        },
        "provider_timing": {
          "additionalProperties": false,
          "properties": {
            "requests": {
              "minimum": 0,
              "type": "integer"
            },
            "request_to_headers_ms": {
              "$ref": "#/$defs/nullableTimingAggregate"
            },
            "first_token_ms": {
              "$ref": "#/$defs/nullableTimingAggregate"
            },
            "stream_completion_ms": {
              "$ref": "#/$defs/nullableTimingAggregate"
            },
            "settlement_ms": {
              "$ref": "#/$defs/nullableTimingAggregate"
            }
          },
          "required": [
            "requests",
            "request_to_headers_ms",
