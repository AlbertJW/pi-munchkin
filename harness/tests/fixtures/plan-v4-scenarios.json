{
  "schema": "pi.plan-scenarios/v1",
  "cohort": "2026-07",
  "admission": {
    "approved": false,
    "authoritative": false,
    "requires_human_approval": true
  },
  "cases": [
    {
      "id": "capability-fit",
      "purpose": "Reject invented or inactive capabilities unless the plan declares a usable fallback.",
      "active_capabilities": ["read", "bash"],
      "inactive_capabilities": ["browser"],
      "required_capability": "browser",
      "valid_fallback": "Use read against the checked-in HTML snapshot.",
      "expected": {
        "without_fallback": "reject",
        "with_fallback": "accept"
      }
    },
    {
      "id": "jump-to-unblock",
      "purpose": "The apparent first implementation step is hard-blocked; a later independent evidence step is legal and unlocks it.",
      "steps": [
        { "id": "implementation", "status": "pending", "hard_depends_on": ["evidence"], "soft_after": [] },
        { "id": "evidence", "status": "pending", "hard_depends_on": [], "soft_after": ["implementation"] }
      ],
      "expected": {
        "eligible": ["evidence"],
        "illegal": ["implementation"]
      }
    },
    {
      "id": "backtrack-on-reveal",
      "purpose": "Later evidence invalidates an earlier convention, reopening it and completed hard dependents without rolling source files back.",
      "steps": [
        { "id": "convention", "status": "done", "hard_depends_on": [] },
        { "id": "implementation", "status": "done", "hard_depends_on": ["convention"] },
        { "id": "documentation", "status": "done", "hard_depends_on": ["implementation"] },
        { "id": "unrelated", "status": "done", "hard_depends_on": [] }
      ],
      "backtrack_target": "convention",
      "expected": {
        "stale": ["convention", "implementation", "documentation"],
        "unchanged": ["unrelated"]
      }
    },
    {
      "id": "tdd-trajectory",
      "purpose": "A matching failed RED command result must precede a matching successful GREEN result.",
      "command": "node --test test/behavior.test.js",
      "events": [
        { "phase": "red", "exit_code": 1 },
        { "phase": "green", "exit_code": 0 }
      ],
      "expected": {
        "order": ["red", "green"],
        "completion": "accept"
      }
    },
    {
      "id": "context-isolation",
      "purpose": "Compare the same routed step core in parent-current and explicit spawn execution without automatic dispatch.",
      "profiles": [
        { "candidate": "c44", "mode": "current", "parent_mutation": "allow", "subagent_required": false },
        { "candidate": "c45", "mode": "spawn", "parent_mutation": "block", "subagent_required": true }
      ],
      "spawn_brief_requires": ["step_id", "objective", "acceptance", "validation_command"],
      "metrics": ["repeated_repository_discovery", "parent_tokens", "child_tokens", "total_tokens", "wall_time", "context_size"]
    }
  ]
}
