{
  "name": "pi-munchkin",
  "version": "0.3.0",
  "description": "Harness extensions for the pi coding agent (hashline edits, anti-loop breaker, verify gate, plan runner, /reflect, guards, span tools, telemetry) \u2014 installable as a pi extension.",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "coding-agent",
    "llm",
    "local-llm",
    "agent-harness"
  ],
  "homepage": "https://github.com/AlbertJW/pi-munchkin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlbertJW/pi-munchkin.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test": "node harness/scripts/run-tests.mjs",
    "typecheck": "tsc -p harness/.typecheck/tsconfig.json --noEmit",
    "health": "bash harness/scripts/pi-health.sh",
    "pack:smoke": "node --experimental-strip-types harness/scripts/package-smoke.mjs",
    "compat:consumer": "node harness/scripts/compat-consumer.mjs",
    "compat:peers": "node harness/scripts/peer-boundary-smoke.mjs",
    "mirror:check": "node harness/scripts/live-mirror-check.mjs",
    "surface:hash:source": "node --experimental-strip-types harness/scripts/source-surface-hash.mjs",
    "secret-scan:diff": "node harness/scripts/secret-scan-diff.mjs",
    "verify:optimizer": "bash scripts/verify-optimizer.sh",
    "verify": "npm run test && npm run typecheck && npm run health && npm run pack:smoke && npm run verify:optimizer"
  },
  "pi": {
    "extensions": [
      "harness/extensions/hashline.ts",
      "harness/extensions/loop-breaker.ts",
      "harness/extensions/tool-call-rescue.ts",
      "harness/extensions/verify-gate.ts",
      "harness/extensions/plan-runner.ts",
      "harness/extensions/reflect.ts",
      "harness/extensions/drift-scanner.ts",
      "harness/extensions/git-guard.ts",
      "harness/extensions/context-inlet-guard.ts",
      "harness/extensions/context-watcher.ts",
      "harness/extensions/span-tools.ts",
      "harness/extensions/compact-tool.ts",
      "harness/extensions/micro-gate.ts",
      "harness/extensions/ketch.ts",
      "harness/extensions/did-you-mean.ts",
      "harness/extensions/teach-hints.ts",
      "harness/extensions/surface-receipt.ts",
      "harness/vendor/pi-subagent/index.ts",
      "harness/extensions/context-brief.ts",
      "harness/extensions/context-dedup.ts",
      "harness/extensions/session-blackboard.ts",
      "harness/extensions/context-surface.ts",
      "harness/extensions/bash-output-guard.ts",
      "harness/extensions/payload-audit.ts",
      "harness/extensions/tool-activation.ts",
      "harness/extensions/runtime-truth.ts"
    ],
    "skills": [
      "skills/deep-research",
      "skills/lavish-review"
    ]
  },
  "dependencies": {
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.80.6",
    "@earendil-works/pi-ai": "0.80.6",
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@earendil-works/pi-tui": "0.80.6",
    "@types/node": "25.2.3",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.6 <0.84.0",
    "@earendil-works/pi-ai": ">=0.80.6 <0.84.0"
  },
  "files": [
    "harness/extensions/hashline.ts",
    "harness/extensions/loop-breaker.ts",
    "harness/extensions/tool-call-rescue.ts",
    "harness/extensions/verify-gate.ts",
